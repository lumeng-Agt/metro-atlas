# Godot editor/import cache and local toolchain
.godot/
.tools/
__pycache__/
*.pyc

# Local exports are kept out of source history. Publish packaged builds as releases.
/release/*.exe
/release/*.zip
/release/*.pck
/release/build-info.txt
/release/SHA256SUMS.txt
/release/media/
/release-candidate/*.exe
/release-candidate/*.zip
/release-candidate/SHA256SUMS.txt
/release-candidate/media/

# Machine-local Godot editor settings, templates, and signing keys
/Godot/

# Basemap tiles are only committed for cities this build publishes. The rest
# stay buildable from tools/build_basemaps.py but are not shipped.
/data/basemap/beijing/
/data/basemap/shanghai/
/data/basemap/guangzhou/
/data/basemap/chengdu/

# Temporary and machine-local files
*.tmp
.tmp-*
.tmp_*
.tmp*/
*.log
*.bak
/test-artifacts/
/test-*/
/docs/*.import
/docs/**/*.import
Thumbs.db
Desktop.ini

# Fetched page cache used by the evidence tools
.cache/
