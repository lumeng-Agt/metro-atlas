; Engine configuration file.
config_version=5

[application]
config/name="造一座地铁"
config/description="在真实城市地图上规划地铁线路"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="MetroAtlas"

[display]
window/size/viewport_width=1600
window/size/viewport_height=980
window/size/window_width_override=1600
window/size/window_height_override=980
window/size/initial_position_type=2
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.095, 1)

[application/run]
max_fps=120
